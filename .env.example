# Database
MONGODB_CONNECTION_STRING=mongodb://localhost:27017
MONGODB_DATABASE_NAME=pminsight

# JWT
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-long
JWT_ISSUER=PMInsight
JWT_AUDIENCE=PMInsightApp
JWT_EXPIRY_MINUTES=60
JWT_REFRESH_EXPIRY_DAYS=7

# Email
SENDGRID_API_KEY=your-sendgrid-api-key
EMAIL_FROM_ADDRESS=noreply@pminsight.com
EMAIL_FROM_NAME=PMInsight

# Storage (Cloudflare R2 - S3 Compatible)
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=pminsight-files
R2_PUBLIC_URL=https://files.pminsight.com

# Redis (optional - for caching & rate limiting)
REDIS_CONNECTION_STRING=localhost:6379

# OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Application
ASPNETCORE_ENVIRONMENT=Development
API_BASE_URL=https://localhost:7001
WEB_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Observability
OTLP_ENDPOINT=http://localhost:4317
SEQ_SERVER_URL=http://localhost:5341

# Feature Flags
ENABLE_BACKGROUND_JOBS=true
ENABLE_REALTIME=true
ENABLE_RATE_LIMITING=true

# Hangfire
HANGFIRE_DASHBOARD_USERNAME=admin
HANGFIRE_DASHBOARD_PASSWORD=change-me-in-production
